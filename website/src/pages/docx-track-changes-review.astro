---
import NarrativePage from '../components/NarrativePage.astro'
const page = {
  "title": "Word tracked changes with AI — Veqtor Workspace",
  "description": "Ask for tracked changes and comments directly in your Word document, then review and accept or reject the edits in Word.",
  "eyebrow": "Tracked changes",
  "heading": "Ask for tracked changes. Review them in Word.",
  "lede": "Your assistant can put the requested revisions into the Word file so you can see what was added or removed.",
  "sections": [
    {
      "id": "request",
      "title": "Make the request explicit",
      "body": [
        "Include “Use tracked changes” in your request. Say which passage to change and what the new wording should achieve. You can ask for a comment explaining an edit or record a decision without changing the text."
      ]
    },
    {
      "id": "review",
      "title": "Review what was added and removed",
      "body": [
        "Open the saved file in Word. Read each change and check the surrounding paragraph. Decide which edits to accept or reject. Do not assume that a clear sentence preserves the original meaning."
      ]
    },
    {
      "id": "existing",
      "title": "Be specific about existing revisions",
      "body": [
        "If the document already contains tracked changes, tell the assistant whether to retain them, accept particular changes or prepare a clean version. Review the result, especially in complex tables, fields and comments."
      ]
    }
  ],
  "path": "/docx-track-changes-review",
  "linkSection": {
    "eyebrow": "Related",
    "title": "More about working with documents",
    "links": [
      {
        "href": "/product",
        "title": "What Workspace does"
      },
      {
        "href": "/how-it-works",
        "title": "How it works"
      },
      {
        "href": "/ai-contract-review",
        "title": "AI contract review"
      },
      {
        "href": "/contract-redline-analysis",
        "title": "Reading contract redlines"
      }
    ]
  }
}
---
<NarrativePage {...page} />
