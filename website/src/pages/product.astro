---
import NarrativePage from '../components/NarrativePage.astro'
const page = {
  "title": "Veqtor Workspace — AI edits in your Word files",
  "description": "Read, revise and save Word documents with your AI assistant. Add comments, ask for tracked changes and choose where the result is saved.",
  "eyebrow": "Veqtor Workspace",
  "heading": "Your instructions. Changes in the document.",
  "lede": "Work with the files on your Mac from your AI chat. Veqtor Workspace gives the assistant a way to read, edit and save the document itself.",
  "sections": [
    {
      "id": "read",
      "title": "Read what matters",
      "body": [
        "Ask for a summary, find a clause or explain the comments. Name the working Word file and any contracts, reports or other documents the assistant should use for context. A reading request does not need to change the file."
      ]
    },
    {
      "id": "edit",
      "title": "Revise the wording or add a comment",
      "body": [
        "Describe the result you want in normal language. Ask explicitly for tracked changes if you want to accept or reject the edits in Word. You can also ask for comments without changing the document text."
      ]
    },
    {
      "id": "save",
      "title": "Choose how to save",
      "body": [
        "Ask the assistant to update your working file or save a new version. Veqtor works on a private copy and checks for saved changes to the original before replacing it. Save and close the file in Word before the task, then reopen it to review the result."
      ]
    }
  ],
  "path": "/product",
  "linkSection": {
    "eyebrow": "Related",
    "title": "More about working with documents",
    "links": [
      {
        "href": "/how-it-works",
        "title": "How it works"
      },
      {
        "href": "/ai-contract-review",
        "title": "AI contract review"
      },
      {
        "href": "/contract-redline-analysis",
        "title": "Reading contract redlines"
      },
      {
        "href": "/docx-track-changes-review",
        "title": "Tracked changes in Word"
      },
      {
        "href": "/veqtor-vs-claude-for-word",
        "title": "Choosing a document workflow"
      }
    ]
  }
}
---
<NarrativePage {...page} />
