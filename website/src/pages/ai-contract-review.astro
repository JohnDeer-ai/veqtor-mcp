---
import NarrativePage from '../components/NarrativePage.astro'
const page = {
  "title": "AI contract review in Word — Veqtor Workspace",
  "description": "Ask your AI assistant to read a contract, explain its wording and put requested revisions or comments into the Word document.",
  "eyebrow": "Contract workflow",
  "heading": "Read the contract. Put the requested changes in Word.",
  "lede": "Veqtor Workspace connects your assistant to the working contract and the documents you identify for context.",
  "sections": [
    {
      "id": "context",
      "title": "Give the assistant the context",
      "body": [
        "Identify the contract, your instructions and any supporting material. Ask for the questions or clauses you need to understand before requesting edits."
      ]
    },
    {
      "id": "instructions",
      "title": "Turn your decision into an edit",
      "body": [
        "Explain the change you want, then ask for tracked changes or a comment. The assistant performs the document task; you remain responsible for the commercial and legal decision."
      ]
    },
    {
      "id": "review",
      "title": "Review the saved contract",
      "body": [
        "Open the result in Word and inspect the wording, comments and existing revisions. Use the contract guides for general background, not as advice on a particular transaction."
      ],
      "links": [
        {
          "href": "/guides",
          "title": "Browse the contract guides"
        }
      ]
    }
  ],
  "path": "/ai-contract-review",
  "linkSection": {
    "eyebrow": "Related",
    "title": "More about working with documents",
    "links": [
      {
        "href": "/product",
        "title": "What Workspace does"
      },
      {
        "href": "/how-it-works",
        "title": "How it works"
      },
      {
        "href": "/contract-redline-analysis",
        "title": "Reading contract redlines"
      },
      {
        "href": "/docx-track-changes-review",
        "title": "Tracked changes in Word"
      }
    ]
  }
}
---
<NarrativePage {...page} />
