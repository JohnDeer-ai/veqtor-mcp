---
import NarrativePage from '../components/NarrativePage.astro'
const page = {
  "title": "How Veqtor Workspace works with your documents",
  "description": "Connect your assistant, identify the Word file and supporting documents, describe the task, then save and review the result.",
  "eyebrow": "How it works",
  "heading": "From your request to a saved Word file.",
  "lede": "Use your assistant’s chat to describe what to read, change or save. The result goes into the document.",
  "sections": [
    {
      "id": "connect",
      "title": "Connect your assistant",
      "body": [
        "Install Veqtor Workspace on your Mac and connect it to Claude Desktop or ChatGPT Desktop. The current connection options are described in the installation guide."
      ],
      "links": [
        {
          "href": "/setup",
          "title": "Installation guide"
        }
      ]
    },
    {
      "id": "context",
      "title": "Point to the documents",
      "body": [
        "Save your Word file. Give the assistant its location and identify any documents it should use for context: contracts, reports, certificates or other records. For text-based PDFs, it can read the text as supporting material."
      ]
    },
    {
      "id": "request",
      "title": "Say what you want done",
      "body": [
        "Ask for a clearer paragraph, revised terms, comments or a summary. Request tracked changes when you want to review each edit. The assistant chooses the method; Veqtor does not decide the wording or legal position."
      ]
    },
    {
      "id": "save",
      "title": "Save and review",
      "body": [
        "Ask to update the working file or save a new version. Avoid editing the same file while the assistant saves. Open the saved result in Word and check the text, formatting, changes and comments."
      ]
    }
  ],
  "path": "/how-it-works",
  "linkSection": {
    "eyebrow": "Related",
    "title": "More about working with documents",
    "links": [
      {
        "href": "/product",
        "title": "What Workspace does"
      },
      {
        "href": "/ai-contract-review",
        "title": "AI contract review"
      },
      {
        "href": "/contract-redline-analysis",
        "title": "Reading contract redlines"
      },
      {
        "href": "/docx-track-changes-review",
        "title": "Tracked changes in Word"
      },
      {
        "href": "/security",
        "title": "Local files and data handling"
      }
    ]
  }
}
---
<NarrativePage {...page} />
