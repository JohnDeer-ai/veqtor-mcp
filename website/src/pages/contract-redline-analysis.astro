---
import NarrativePage from '../components/NarrativePage.astro'
const page = {
  "title": "Contract redline analysis — Veqtor Workspace",
  "description": "Read tracked changes and comments in Word contracts, ask focused questions and prepare requested edits with your AI assistant.",
  "eyebrow": "Contract redlines",
  "heading": "Understand the changes before you respond.",
  "lede": "Point your assistant to the Word drafts you want it to read. Ask about a specific clause, comment or change, then decide what to do next.",
  "sections": [
    {
      "id": "read",
      "title": "Read the relevant drafts",
      "body": [
        "Name the files and explain which version you are working on. Ask the assistant to quote the relevant wording and identify the document it came from. A summary does not replace checking the source."
      ]
    },
    {
      "id": "respond",
      "title": "Give a clear response instruction",
      "body": [
        "Ask for the wording you want inserted, removed or clarified. Request tracked changes so you can review the edits in Word. Add a comment when you want a question or decision recorded beside the clause."
      ]
    },
    {
      "id": "save",
      "title": "Keep the version you need",
      "body": [
        "Save the result to the working file or ask for a new version. Check existing revisions and comments before sharing it. Workspace does not automatically reconstruct missing negotiation rounds or certify the meaning of a change."
      ]
    },
    {
      "id": "earlier",
      "title": "Looking for the earlier negotiation tools?",
      "body": [
        "Veqtor MCP 0.5 is the previous product. Its release, documentation and recorded demo remain available separately."
      ],
      "links": [
        {
          "href": "/veqtor-mcp",
          "title": "Earlier Veqtor MCP"
        },
        {
          "href": "/demo",
          "title": "Earlier product demo"
        }
      ]
    }
  ],
  "path": "/contract-redline-analysis",
  "linkSection": {
    "eyebrow": "Related",
    "title": "More about working with documents",
    "links": [
      {
        "href": "/product",
        "title": "What Workspace does"
      },
      {
        "href": "/how-it-works",
        "title": "How it works"
      },
      {
        "href": "/ai-contract-review",
        "title": "AI contract review"
      },
      {
        "href": "/docx-track-changes-review",
        "title": "Tracked changes in Word"
      }
    ]
  }
}
---
<NarrativePage {...page} />
