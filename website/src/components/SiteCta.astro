---
interface Props {
  title?: string
  body?: string
  primaryHref?: string
  primaryLabel?: string
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  title = 'Put your next edit into the document.',
  body,
  primaryHref = '/setup',
  primaryLabel = 'Get started',
  secondaryHref = '/#examples',
  secondaryLabel = 'See examples',
} = Astro.props
---

<section class="site-cta">
  <div class="shell site-cta__inner">
    <div>
      <p class="eyebrow">Veqtor Workspace</p>
      <h2>{title}</h2>
      {body && <p>{body}</p>}
    </div>
    <div class="actions">
      <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
      <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
